# Google Places (live reviews)
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=

# Google listing link shown in the reviews section
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=

# Quote request dashboard
# Run data/quote-requests.sql in Supabase, then set these in .env.local/deployment.
# Use a backend-only Supabase secret key (sb_secret_...) or legacy service_role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_QUOTE_REQUESTS_TABLE=quote_requests

# Used to unlock /dashboard.
DASHBOARD_PASSWORD=

# Optional: use a separate secret for signing dashboard sessions.
DASHBOARD_SESSION_SECRET=

# Contact form - delivered to info@stornway.com.
CONTACT_TO_EMAIL=info@stornway.com

# Option A: Resend
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Stornway Group <quotes@stornway.com>

# Option B: SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
